APP_NAME=Ase
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (PostgreSQL 16 — the system of record) --------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=buddypay
DB_USERNAME=buddypay
DB_PASSWORD=buddypay

# --- Cache / queue / locks (Redis 7 — never the source of financial
# truth; PostgreSQL + ledger are authoritative) --------------------------
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

FILESYSTEM_DISK=local
FILESYSTEM_AWS_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@ase.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- Aṣẹ platform --------------------------------------------------------
ASE_BASE_CURRENCY=NGN
ASE_REFERENCE_PREFIX=ASE
ASE_RESERVATION_TTL_MINUTES=15

# Mock provider behaviour (dev/test): success | failure | timeout
ASE_MOCK_MODE=success
ASE_MOCK_FUNDING_MODE=success
ASE_MOCK_PAYOUT_MODE=success

ASE_DEFAULT_BILL_PROVIDER=mock
ASE_DEFAULT_FUNDING_PROVIDER=mock
ASE_WEBHOOK_SECRET_MOCK=change-me-in-production

# --- Wema (ALAT) Developer API --------------------------------------------
# Docs: https://wema-alatdev-apimgt.developer.azure-api.net/
# Test portal (default) or the production base URL issued at onboarding.
WEMA_BASE_URL=https://wema-alatdev-apimgt.developer.azure-api.net
WEMA_API_KEY=
# Public URL Wema posts payment-request / payout callbacks to.
WEMA_WEBHOOK_URL=
ASE_WEBHOOK_SECRET_WEMA=change-me-in-production
# --- Monnify API ------------------------------------------------------------
# Docs: https://developers.monnify.com/
# Sandbox base URL for development; live: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=
# Used for OAuth token exchange AND webhook signature verification
# (HMAC-SHA512, `monnify-signature` header — production only).
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
# Monnify disbursement wallet account that funds payouts.
MONNIFY_SOURCE_ACCOUNT=

ASE_DEFAULT_PAYOUT_PROVIDER=wema

VITE_APP_NAME="${APP_NAME}"
